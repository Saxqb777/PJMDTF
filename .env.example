# Neon Postgres connection string for the pjmdtf-mumbai project.
# Get it from the Neon dashboard. Set it in Vercel as an environment variable.
# NEVER commit the real value.
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Optional. Overrides the password for /report without needing a commit.
# If unset, the digest compiled into src/lib/auth.ts is used.
SITE_PASSWORD=""
